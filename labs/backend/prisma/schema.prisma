generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  employees   Employee[]
}

model Employee {
  id         Int    @id @default(autoincrement())
  firstName  String
  lastName   String
  salary     Float
  roleId     Int
  role       Role   @relation(fields: [roleId], references: [id])
}